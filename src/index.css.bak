:root{--bg:#dcebf7;--card:#fff;--ink:#1f3140;--mut:#566b7b;--line:#b3cade;--bd:#1f6fa8;--gray:#edf2f6;--bar:#6d777e;--tan:rgba(196,223,244,.62);--tan2:rgba(255,255,255,.78);--frame:rgba(170,208,238,.8);--ok:#1b7f4d;--bad:#a83228;--warn:#8a5a0a;--okbg:#d3f0df;--infobg:#d6e8f6;--warnbg:#f6e6bd;--viobg:#e4def2;--badbg:#f6d8d3;--vio:#5d49a6;--g1:#bcdaf0;--g2:#e6f2fa;--g3:#d3efe1;--gA:rgba(255,255,255,.82);--gB:rgba(198,225,246,.7);--fr:rgba(170,208,238,.8);--edge:#5b82a3;--info:#1f6a94;box-sizing:border-box;padding-top:env(safe-area-inset-top,0px);padding-bottom:env(safe-area-inset-bottom,0px)}
@media (prefers-color-scheme:dark){:root:not([data-theme="light"]){--bg:#0f1e2a;--card:#182b39;--ink:#e4eff7;--mut:#9db4c4;--line:#365570;--bd:#66b8ee;--gray:#223747;--bar:#5a656d;--tan:rgba(40,80,110,.5);--tan2:rgba(20,45,62,.7);--frame:rgba(60,105,140,.6);--ok:#7bd8a2;--bad:#f0928a;--warn:#e8c070;--okbg:#1f4a35;--infobg:#21425a;--warnbg:#4a3b1c;--viobg:#3a3459;--badbg:#54302c;--vio:#b9a8f0;--g1:#0d2233;--g2:#122a3b;--g3:#12332b;--gA:rgba(75,115,145,.8);--gB:rgba(30,58,82,.78);--fr:rgba(70,110,145,.7);--edge:#7fa6c4;--info:#8cc4e2}}
:root[data-theme="dark"]{--bg:#0f1e2a;--card:#182b39;--ink:#e4eff7;--mut:#9db4c4;--line:#365570;--bd:#66b8ee;--gray:#223747;--bar:#5a656d;--tan:rgba(40,80,110,.5);--tan2:rgba(20,45,62,.7);--frame:rgba(60,105,140,.6);--ok:#7bd8a2;--bad:#f0928a;--warn:#e8c070;--okbg:#1f4a35;--infobg:#21425a;--warnbg:#4a3b1c;--viobg:#3a3459;--badbg:#54302c;--vio:#b9a8f0;--g1:#0d2233;--g2:#122a3b;--g3:#12332b;--gA:rgba(75,115,145,.8);--gB:rgba(30,58,82,.78);--fr:rgba(70,110,145,.7);--edge:#7fa6c4;--info:#8cc4e2}
html{scroll-padding-top:env(safe-area-inset-top,0px)}
*,*::before,*::after{box-sizing:border-box;border-radius:0!important}
body{margin:0;padding:0 12px;background:var(--bg) linear-gradient(var(--card),var(--bg) 380px) no-repeat;color:var(--ink);font:500 14.5px/1.5 Figtree,system-ui,-apple-system,"Segoe UI",sans-serif;min-height:100vh;border-top:4px solid var(--bd)}
#hd,main,nav{max-width:1040px;margin:0 auto}
header{display:flex;justify-content:space-between;align-items:center;gap:12px;padding:20px 0 16px}
.brand{display:flex;align-items:center;gap:12px;font:400 25px/1 "Segoe UI",Figtree,system-ui,sans-serif;cursor:pointer}
.logo{width:46px;height:46px;background:var(--bd);display:grid;place-items:center;border:2px solid var(--card);outline:1px solid var(--bd)}.logo svg{width:26px;height:26px}
.who{display:flex;align-items:center;gap:10px;font-size:13px;color:var(--mut)}.role{background:var(--bd);color:#fff;padding:4px 14px;font-weight:600}
nav{display:flex;flex-wrap:wrap;background:var(--bd)}
nav button{font:700 12px/1 Figtree,sans-serif;text-transform:uppercase;letter-spacing:.03em;color:#fff;background:none;border:0;border-right:1px solid rgba(255,255,255,.22);padding:14px 16px;cursor:pointer}
nav button.on{background:var(--tan2);color:var(--bd)}nav button:hover:not(.on){background:rgba(0,0,0,.2)}
main{margin:20px auto 50px;padding:26px 24px 34px;background:var(--card);border:1px solid var(--line);box-shadow:0 8px 0 -4px var(--tan)}
main.home{background:none;border:0;box-shadow:none;padding:0}
h1{font:400 30px/1.15 "Segoe UI",Figtree,system-ui,sans-serif;margin:0 0 4px;color:var(--bd)}h2{font:600 18px "Segoe UI",Figtree,system-ui,sans-serif;margin:26px 0 10px}
.sub{color:var(--mut);margin:0 0 20px}.crumb{color:var(--mut);font-size:13px;margin-bottom:14px}.crumb a{color:var(--bd);cursor:pointer;font-weight:700}
.grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(260px,1fr));gap:16px}
.card{background:var(--card);border:1px solid var(--line);padding:18px}
.dcard{background:var(--tan2);border:1px solid var(--line);border-left:4px solid var(--bd);padding:14px 16px;cursor:pointer;text-align:left;font:inherit;color:inherit;width:100%}.dcard:hover{background:var(--tan)}
.dcard b{display:block;font:600 15px "Segoe UI",Figtree,system-ui,sans-serif;color:var(--bd)}.dcard small{color:var(--mut)}
table{width:100%;border-collapse:collapse;font-size:14px}th,td{text-align:left;padding:10px 12px;border-bottom:1px solid var(--line);vertical-align:middle}th{background:var(--tan2);font-weight:700;font-size:13px}
.tw{overflow-x:auto;background:var(--card);border:1px solid var(--line)}
.badge{display:inline-block;padding:2px 10px;font-size:12.5px;font-weight:700;white-space:nowrap}
.s-Available,.s-Returned,.s-Approved{background:var(--okbg);color:var(--ok)}.s-In-Use,.s-Requested{background:var(--infobg);color:var(--info)}.s-Under-Maintenance,.s-Preparing{background:var(--warnbg);color:var(--warn)}.s-Ready-for-Pickup{background:var(--viobg);color:var(--vio)}.s-Rejected{background:var(--badbg);color:var(--bad)}
button.btn{font:inherit;font-weight:700;border:0;padding:8px 18px;cursor:pointer;background:var(--bd);color:#fff}button.btn.alt{background:var(--bar)}button.btn.bad{background:#a83228}button.btn.sm{padding:4px 13px;font-size:13px}button:disabled{opacity:.45;cursor:not-allowed}
button:focus-visible,input:focus-visible,select:focus-visible,textarea:focus-visible{outline:3px solid var(--bd);outline-offset:2px}nav button:focus-visible{outline-color:#fff;outline-offset:-3px}
label{display:block;font-size:13px;font-weight:700;color:var(--mut);margin:0 0 4px}
input,select,textarea{font:inherit;width:100%;padding:9px 12px;border:1px solid var(--line);background:var(--card);color:var(--ink)}
.f{display:grid;grid-template-columns:repeat(auto-fit,minmax(220px,1fr));gap:14px}.f .w{grid-column:1/-1}
.bar{display:flex;gap:10px;flex-wrap:wrap;align-items:center;margin-bottom:14px}.bar input,.bar select{width:auto;min-width:170px}
.login{max-width:400px;margin:6vh auto 0}.login .card{padding:28px;background:var(--tan2);border-top:4px solid var(--bd)}
.hint{font-size:12.5px;color:var(--mut);margin-top:14px;line-height:1.7}.err{color:var(--bad);font-weight:700;font-size:13.5px;min-height:20px;margin-top:8px}
.ro{background:var(--gray)}.toast{position:fixed;bottom:calc(20px + env(safe-area-inset-bottom,0px));left:50%;transform:translateX(-50%);background:var(--ink);color:var(--card);padding:10px 20px;font-weight:700;z-index:9}
.steps{display:flex;gap:4px;flex-wrap:wrap}.steps i{font-style:normal;font-size:11.5px;padding:2px 8px;background:var(--gray);color:var(--mut)}.steps i.on{background:var(--bd);color:#fff}
.empty{padding:30px;text-align:center;color:var(--mut)}
.hero{background:var(--frame);padding:18px;display:grid;grid-template-columns:1.1fr 1fr;box-shadow:0 10px 0 -5px var(--tan)}
.art{background:linear-gradient(135deg,#cfe8f7,#d3efdc);min-height:250px;border:3px solid var(--card)}.art svg{display:block;width:100%;height:100%}
.msg{background:var(--tan2);border:1px solid var(--line);padding:30px 34px;display:flex;flex-direction:column;justify-content:center;gap:18px}
.msg p{font:400 27px/1.25 "Segoe UI",Figtree,system-ui,sans-serif;margin:0;color:var(--mut)}.msg a{cursor:pointer;color:var(--bd);font-weight:700}
.panel{background:var(--tan);margin-top:24px;padding:18px;display:grid;grid-template-columns:210px 1fr 230px;gap:18px;border:1px solid var(--line);box-shadow:0 10px 0 -5px var(--line)}
.panel h3{margin:0 0 10px;background:var(--bar);color:#fff;text-align:center;font:600 12px/1 Figtree,sans-serif;letter-spacing:.08em;text-transform:uppercase;padding:10px}
.box,.tiles{background:var(--tan2);border:1px solid var(--line);padding:14px}
.row{display:flex;justify-content:space-between;align-items:center;padding:7px 0;border-bottom:1px solid var(--line)}.row:last-child{border:0}.row b{font:600 22px "Segoe UI",Figtree,system-ui,sans-serif;color:var(--bd)}
.tiles{display:grid;grid-template-columns:repeat(3,1fr);gap:18px;padding:16px}
.tile{background:none;border:0;font:inherit;color:inherit;text-align:left;cursor:pointer;padding:0;display:flex;flex-direction:column;gap:6px}
.ph{background:linear-gradient(135deg,#cfe8f7,#d3efdc);border:1px solid var(--ink);outline:5px solid var(--card);margin:5px 5px 10px;aspect-ratio:1/1;display:grid;place-items:center}
.ph svg{width:52%;height:52%;stroke:#8a1428;fill:none;stroke-width:1.4;stroke-linecap:round;stroke-linejoin:round}
.tile b{font:400 17px/1.2 "Segoe UI",Figtree,system-ui,sans-serif;color:var(--bd)}.tile small{color:var(--mut);font-size:12.5px}.tile:hover b{text-decoration:underline}
.blog a{display:block;padding:8px 0;border-bottom:1px solid var(--line);color:var(--bd);font-weight:600;font-size:13px;cursor:pointer}.blog a i{display:block;color:var(--mut);font-weight:400;font-size:12px}
@media (max-width:820px){.hero,.panel{grid-template-columns:1fr}.tiles{grid-template-columns:1fr 1fr}}
@media (max-width:520px){.tiles{grid-template-columns:1fr}.brand{font-size:19px}.logo{width:38px;height:38px}main{padding:20px 14px}.msg p{font-size:22px}}

body{background:var(--bg) linear-gradient(180deg,var(--g1) 0,var(--g2) 45%,var(--g3) 100%) fixed;border-top:0;font-family:"Segoe UI",Figtree,system-ui,sans-serif}
header{margin-top:14px;padding:12px 16px;background:linear-gradient(180deg,var(--gA) 0,var(--gA) 50%,var(--gB) 51%,var(--gB) 100%);border:1px solid rgba(255,255,255,.8);outline:1px solid var(--edge);backdrop-filter:blur(8px);box-shadow:0 4px 14px rgba(20,60,100,.25),inset 0 1px 0 rgba(255,255,255,.7)}
.brand{font-weight:600;color:var(--ink)}
.logo{background:linear-gradient(#7be0ab,#38b06f 49%,#26935a 51%,#42bd7c);border:1px solid #1d7047;outline:1px solid rgba(255,255,255,.8);box-shadow:inset 0 1px 0 rgba(255,255,255,.7)}
.role{background:linear-gradient(#6fd9a0,#33a86a 49%,#248f57 51%,#3db877);border:1px solid #1d7047;text-shadow:0 -1px 0 rgba(0,0,0,.3);box-shadow:inset 0 1px 0 rgba(255,255,255,.6)}
nav{margin-top:10px;padding:4px;gap:4px;background:linear-gradient(180deg,var(--gA) 0,var(--gA) 50%,var(--gB) 51%,var(--gB) 100%);border:1px solid rgba(255,255,255,.8);outline:1px solid var(--edge);backdrop-filter:blur(8px);box-shadow:0 3px 10px rgba(20,60,100,.2)}
nav button{color:var(--ink);text-transform:none;font:600 13px/1 "Segoe UI",Figtree,sans-serif;letter-spacing:0;border:1px solid transparent;padding:10px 16px}
nav button:hover:not(.on){background:linear-gradient(180deg,rgba(255,255,255,.7) 0,rgba(190,225,250,.6) 50%,rgba(150,200,240,.5) 51%,rgba(200,235,255,.6) 100%);border-color:#7fb0d8}
nav button.on{background:linear-gradient(#f2fcf6,#d3f2e1 50%,#a6e0c0 51%,#c9f1dc);border-color:#4f9f79;color:#14563a;box-shadow:inset 0 1px 0 #fff,0 0 6px rgba(80,190,130,.55)}
main{background:var(--card);background-clip:padding-box;border:7px solid var(--fr);outline:1px solid var(--edge);backdrop-filter:blur(6px);box-shadow:0 12px 30px rgba(15,50,90,.3)}
main.home{background:none;border:0;outline:0;backdrop-filter:none;box-shadow:none}
.hero,.panel{border:1px solid rgba(255,255,255,.8);outline:1px solid var(--edge);backdrop-filter:blur(6px);box-shadow:0 8px 24px rgba(15,50,90,.25)}
.msg,.box,.tiles{border:1px solid rgba(255,255,255,.7);box-shadow:inset 0 1px 0 rgba(255,255,255,.6),0 1px 3px rgba(20,60,100,.18)}
.panel h3{background:linear-gradient(#9aa4aa,#78838a 49%,#5f6a71 51%,#7b868d);border:1px solid #4d565c;text-shadow:0 -1px 0 rgba(0,0,0,.35);box-shadow:inset 0 1px 0 rgba(255,255,255,.5)}
.ph svg{stroke:#1f6fa8}
th{background:linear-gradient(180deg,var(--gA) 0,var(--gA) 50%,var(--gB) 51%,var(--gB) 100%);border-bottom:1px solid var(--line)}
button.btn{border:1px solid #1a5c8a;background:linear-gradient(#6cbcee 0,#3f9ad6 49%,#1f78b8 51%,#3a9fdc 100%);text-shadow:0 -1px 0 rgba(0,0,0,.3);box-shadow:inset 0 1px 0 rgba(255,255,255,.65),0 1px 2px rgba(0,0,0,.3)}
button.btn:hover{filter:brightness(1.1)}button.btn:active{filter:brightness(.9)}
button.btn.alt{border-color:#4d565c;background:linear-gradient(#b4bcc2,#8a949b 49%,#6d777e 51%,#8f999f)}
button.btn.bad{border-color:#7d1f17;background:linear-gradient(#e78a80,#cf4d41 49%,#b0342a 51%,#cc5347)}
input,select,textarea{border:1px solid var(--line);box-shadow:inset 0 1px 2px rgba(0,0,0,.14)}
.steps i.on{background:linear-gradient(#6cbcee,#3f9ad6 49%,#1f78b8 51%,#3a9fdc);color:#fff}
.login .card{border:1px solid rgba(255,255,255,.8);outline:1px solid var(--edge);border-top:4px solid #38b06f;box-shadow:0 10px 30px rgba(15,50,90,.3)}
.toast{background:linear-gradient(#6cbcee,#3f9ad6 49%,#1f78b8 51%,#3a9fdc);color:#fff;border:1px solid #1a5c8a}
