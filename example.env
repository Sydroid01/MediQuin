# Copy this file to ".env" (same folder) and adjust. The .env file is private: never commit or share it.

# Where MongoDB lives.
#   Local MongoDB / Docker:  mongodb://127.0.0.1:27017/mediquin
#   MongoDB Atlas (cloud):   mongodb+srv://<user>:<password>@<cluster>.mongodb.net/mediquin?retryWrites=true&w=majority
MONGODB_URI=mongodb://127.0.0.1:27017/mediquin

PORT=4000

# Secrets. These dev values work out of the box, but the server REFUSES to start in production with them.
# Generate real ones with:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Note: changing PIN_PEPPER later makes every stored PIN stop working (re-seed or reset PINs).
JWT_SECRET=dev-only-change-me-jwt-secret
PIN_PEPPER=dev-only-change-me-pin-pepper

# Only needed if the React app is hosted on a different domain than this server (comma-separated).
# CLIENT_ORIGIN=https://your-frontend.example.com